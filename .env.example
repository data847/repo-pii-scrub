# Copy to .env and fill in. Never commit the real file.

# Gate 3 (LLM privacy review)
ANTHROPIC_API_KEY=

# Optional: override the review model
# PII_SCRUB_MODEL=

# Deterministic redaction salt. Generate with: openssl rand -hex 32
# Treat as a secret — it makes pseudonyms linkable back to originals.
REPO_SANITIZER_SALT=

# NER: must be cpu on hosts without CUDA (e.g. Apple Silicon)
PII_SCRUB_NER_DEVICE=cpu
# PII_SCRUB_NER_SERVICE_URL=http://127.0.0.1:8765
# PII_SCRUB_NER_SCOPE=head
